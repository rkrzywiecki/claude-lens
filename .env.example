# claude-lens settings. Every variable is optional; the values below are the defaults.

# SQLite database with imported request records.
LENS_DB_PATH=~/.claude-lens/lens.db

# Root of the Claude Code session transcripts (one directory per project).
LENS_TRANSCRIPTS_DIR=~/.claude/projects

# Custom price table (copy of src/claude_lens/data/pricing.yaml). Empty = bundled table.
LENS_PRICING_PATH=

# Level of the JSON logs written to stderr: DEBUG, INFO, WARNING, ERROR.
LENS_LOG_LEVEL=WARNING

# --- Proxy (claude-lens serve) ---

# Where requests are forwarded.
LENS_UPSTREAM_URL=https://api.anthropic.com

# Upstream timeout in seconds (connect, read and write; long generations need minutes).
LENS_UPSTREAM_TIMEOUT=600

# Listen address and port. A non-loopback address also needs LENS_ALLOW_NON_LOOPBACK=true.
LENS_HOST=127.0.0.1
LENS_PORT=8788

# Allow a non-loopback listen address (plain HTTP: terminate TLS in front of the proxy).
LENS_ALLOW_NON_LOOPBACK=false

# LLM coach (`claude-lens insights --coach`). Credentials come from ANTHROPIC_API_KEY or an
# `ant auth login` profile; claude-lens itself stores none.
LENS_COACH_MODEL=claude-opus-5-5
LENS_COACH_EFFORT=medium
LENS_COACH_LANGUAGE=English
LENS_COACH_TIMEOUT=120
